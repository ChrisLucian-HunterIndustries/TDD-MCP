                    "type": "string"
                },
                "old_string": {
                    "title": "Old String",
                    "type": "string"
                },
                "path": {
                    "title": "Path",
                    "type": "string"
                }
            },
            "required": [
                "location",
                "path",
                "old_string",
                "new_string"
            ],
            "title": "edit_fileArguments",
            "type": "object"
        },
        "name": "edit_file",
        "output_schema": {
            "properties": {
                "result": {
                    "title": "Result",
