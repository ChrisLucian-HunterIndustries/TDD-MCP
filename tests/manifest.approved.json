[
    {
        "description": "Show the current TDD phase and what may be written in it.\n\nArgs:\n    location: Path to the project root.\n",
        "input_schema": {
            "properties": {
                "location": {
                    "title": "Location",
                    "type": "string"
                }
            },
            "required": [
                "location"
            ],
            "title": "tdd_statusArguments",
            "type": "object"
        },
        "name": "tdd_status",
        "output_schema": {
            "properties": {
                "result": {
                    "title": "Result",
                    "type": "string"
                }
            },
            "required": [
                "result"
            ],
            "title": "tdd_statusOutput",
            "type": "object"
        }
    },
    {
        "description": "Plan the task's tests: a TDD session's first step, allowed only in the plan phase.\n\nList every test the task needs, and no more, smallest behaviour first.\nOrder them so each one fails when it is written: a test that would\nalready pass is redundant or out of order. Give each a unique name, an\narrange (the setup), an act (the one call) and an assert (the exact\nexpected result). Once every planned test is done you are back in the\nplan phase: plan only what the task still lacks, or stop.\n\nArgs:\n    location: Path to the project root.\n    tests: The tests in the order to write them.\n",
        "input_schema": {
            "$defs": {
                "PlannedTestSpec": {
                    "properties": {
                        "act": {
                            "title": "Act",
                            "type": "string"
                        },
                        "arrange": {
                            "title": "Arrange",
                            "type": "string"
                        },
                        "assert": {
                            "title": "Assert",
                            "type": "string"
                        },
                        "name": {
                            "title": "Name",
                            "type": "string"
                        }
                    },
                    "title": "PlannedTestSpec",
                    "type": "object"
                }
            },
            "properties": {
                "location": {
                    "title": "Location",
                    "type": "string"
                },
                "tests": {
                    "items": {
                        "$ref": "#/$defs/PlannedTestSpec"
                    },
                    "title": "Tests",
                    "type": "array"
                }
            },
            "required": [
                "location",
                "tests"
            ],
            "title": "plan_testsArguments",
            "type": "object"
        },
        "name": "plan_tests",
        "output_schema": {
            "properties": {
                "result": {
                    "title": "Result",
                    "type": "string"
                }
            },
            "required": [
                "result"
            ],
            "title": "plan_testsOutput",
            "type": "object"
        }
    },
    {
        "description": "Run every test with coverage and move to the phase the results call for.\n\nThe only tool that starts a cycle or changes phase. Call it first, after\neach refactor, and after any change made outside this server (e.g. a git\nreset). All pass: red, or plan once every planned test is done. Exactly\none fails: green. Several fail: red, edit the tests until one fails.\n\nArgs:\n    location: Path to the project root.\n    language: The project's language, which decides how tests are run.\n",
        "input_schema": {
            "properties": {
                "language": {
                    "default": "python",
                    "enum": [
                        "python",
                        "typescript"
                    ],
                    "title": "Language",
                    "type": "string"
                },
                "location": {
                    "title": "Location",
                    "type": "string"
                }
            },
            "required": [
                "location"
            ],
            "title": "advance_tdd_phaseArguments",
            "type": "object"
        },
        "name": "advance_tdd_phase",
        "output_schema": {
            "properties": {
                "result": {
                    "title": "Result",
                    "type": "string"
                }
            },
            "required": [
                "result"
            ],
            "title": "advance_tdd_phaseOutput",
            "type": "object"
        }
    },
    {
        "description": "Go back from green to red to fix tests that no production change can satisfy.\n\nUse it when older tests still assert the old behaviour, or the new test\nitself is wrong (e.g. a missing import). Uncommitted production changes\ngo to git stash.\n\nArgs:\n    location: Path to the project root.\n",
        "input_schema": {
            "properties": {
                "location": {
                    "title": "Location",
                    "type": "string"
                }
            },
            "required": [
                "location"
            ],
            "title": "return_to_redArguments",
            "type": "object"
        },
        "name": "return_to_red",
        "output_schema": {
            "properties": {
                "result": {
                    "title": "Result",
                    "type": "string"
                }
            },
            "required": [
                "result"
            ],
            "title": "return_to_redOutput",
            "type": "object"
        }
    },
    {
        "description": "Undo the current cycle and restart it in red, when no other tool gets you on.\n\nResets to the commit where the cycle started. Dropped commits stay under\nrefs/tdd-mcp/, uncommitted work in git stash.\n\nArgs:\n    location: Path to the project root.\n",
        "input_schema": {
            "properties": {
                "location": {
                    "title": "Location",
                    "type": "string"
                }
            },
            "required": [
                "location"
            ],
            "title": "rollback_cycleArguments",
            "type": "object"
        },
        "name": "rollback_cycle",
        "output_schema": {
            "properties": {
                "result": {
                    "title": "Result",
                    "type": "string"
                }
            },
            "required": [
                "result"
            ],
            "title": "rollback_cycleOutput",
            "type": "object"
        }
    },
    {
        "description": "Run every test with coverage and list untested lines. Never changes the phase.\n\nArgs:\n    location: Path to the project root.\n    language: The project's language, which decides how tests are run.\n",
        "input_schema": {
            "properties": {
                "language": {
                    "default": "python",
                    "enum": [
                        "python",
                        "typescript"
                    ],
                    "title": "Language",
                    "type": "string"
                },
                "location": {
                    "title": "Location",
                    "type": "string"
                }
            },
            "required": [
                "location"
            ],
            "title": "run_coverageArguments",
            "type": "object"
        },
        "name": "run_coverage",
        "output_schema": {
            "properties": {
                "result": {
                    "title": "Result",
                    "type": "string"
                }
            },
            "required": [
                "result"
            ],
            "title": "run_coverageOutput",
            "type": "object"
        }
    },
    {
        "description": "Run tests without coverage to check progress. Never changes the phase.\n\nRuns every test by default; narrow it with `path` (a test file or folder)\nand/or `test_name` (pytest -k, vitest -t).\n\nArgs:\n    location: Path to the project root.\n    path: Test file or folder, relative to `location` (or absolute, inside it).\n    test_name: Name, or part of a name, of the test(s) to run.\n",
        "input_schema": {
            "properties": {
                "location": {
                    "title": "Location",
                    "type": "string"
                },
                "path": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Path"
                },
                "test_name": {
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": null,
                    "title": "Test Name"
                }
            },
            "required": [
                "location"
            ],
            "title": "run_testsArguments",
            "type": "object"
        },
        "name": "run_tests",
        "output_schema": {
            "properties": {
                "result": {
                    "title": "Result",
                    "type": "string"
                }
            },
            "required": [
                "result"
            ],
            "title": "run_testsOutput",
            "type": "object"
        }
    },
    {
        "description": "Create or overwrite a whole file if the phase allows it, then run the tests.\n\nTests are writable in red and refactor, production code in green and\nrefactor. Overwriting must keep the file's top-level definitions; to\nchange part of a file, use edit_file.\n\nArgs:\n    location: Path to the project root.\n    path: File path, relative to `location` (or absolute, inside it).\n    content: The complete new file content.\n",
        "input_schema": {
            "properties": {
                "content": {
                    "title": "Content",
                    "type": "string"
                },
                "location": {
                    "title": "Location",
                    "type": "string"
                },
                "path": {
                    "title": "Path",
                    "type": "string"
                }
            },
            "required": [
                "location",
                "path",
                "content"
            ],
            "title": "write_fileArguments",
            "type": "object"
        },
        "name": "write_file",
        "output_schema": {
            "properties": {
                "result": {
                    "title": "Result",
                    "type": "string"
                }
            },
            "required": [
                "result"
            ],
            "title": "write_fileOutput",
            "type": "object"
        }
    },
    {
        "description": "Replace one exact occurrence of `old_string` if the phase allows it, then run the tests.\n\nCopy `old_string` from the file as it is now; read the file first if\nunsure.\n\nArgs:\n    location: Path to the project root.\n    path: File path, relative to `location` (or absolute, inside it).\n    old_string: Exact current text; must occur exactly once in the file.\n    new_string: Replacement text.\n",
        "input_schema": {
            "properties": {
                "location": {
                    "title": "Location",
                    "type": "string"
                },
                "new_string": {
                    "title": "New String",
                    "type": "string"
                },
                "old_string": {
                    "title": "Old String",
                    "type": "string"
                },
                "path": {
                    "title": "Path",
                    "type": "string"
                }
            },
            "required": [
                "location",
                "path",
                "old_string",
                "new_string"
            ],
            "title": "edit_fileArguments",
            "type": "object"
        },
        "name": "edit_file",
        "output_schema": {
            "properties": {
                "result": {
                    "title": "Result",
                    "type": "string"
                }
            },
            "required": [
                "result"
            ],
            "title": "edit_fileOutput",
            "type": "object"
        }
    }
]
